# PostgreSQL / Neon + Shared JWT Auth (MUST match Backend DATABASE_URL and JWT_SECRET)
DATABASE_URL=postgresql://user:password@your-postgres-host:5432/neondb?sslmode=require
JWT_SECRET=replace_with_32_plus_char_random_jwt_secret
# Browser URL to your separately deployed NestJS Backend (e.g. https://your-backend.vercel.app)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000/api/v1
# Optional runtime server fallback used by Next.js /api/backend proxy & OAuth callback
BACKEND_URL=
# Optional dedicated WebSocket URL if Socket.IO runs on a separate persistent Node host (e.g. Railway/Render)
NEXT_PUBLIC_SOCKET_URL=

# Cloudinary Configuration (For Chat Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Alternatively:
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Platform Help Center Base Domain (Wildcard: *.orbathelp.com)
HELP_BASE_DOMAIN=orbathelp.com
NEXT_PUBLIC_HELP_BASE_DOMAIN=orbathelp.com

# Base App URL for callbacks, redirects, invites, and emails (e.g. https://zen-try.site)
# IMPORTANT: In Vercel Project Settings -> Environment Variables, set NEXT_PUBLIC_APP_URL to your live production domain, NOT localhost.
NEXT_PUBLIC_APP_URL=https://orbatai.com

# Shared secret Vercel Cron sends to /api/cron/* routes (Authorization: Bearer ...)
CRON_SECRET=bc3cc238c8c11a9f5c97176a3c0046acd8da6df57a65295a

# Channels (WhatsApp Business Cloud API) — see CLAUDE.md "Channels"
# 32 random bytes that encrypt channel tokens at rest: openssl rand -base64 32
CHANNEL_ENCRYPTION_KEY=
# Graph API version for WhatsApp calls (default v23.0)
META_GRAPH_API_VERSION=v23.0
# Platform Meta app, needed for Embedded Signup and the shared webhook URL
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business configuration id for WhatsApp Embedded Signup
META_WHATSAPP_CONFIG_ID=
# Verify token you enter in the Meta app's webhook settings for /api/channels/whatsapp/webhook
META_WEBHOOK_VERIFY_TOKEN=

# Instagram (Instagram API with Instagram Login) — see CLAUDE.md "Channels"
# The Instagram app's id/secret (Meta app → Instagram → API setup with Instagram login).
# Needed for "Sign in with Instagram" and the shared webhook /api/channels/instagram/webhook.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Verify token you enter in the Instagram webhook settings
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Set to true only once Meta has approved the Human Agent feature for the app
INSTAGRAM_HUMAN_AGENT_ENABLED=false
# Optional, default v23.0
INSTAGRAM_GRAPH_API_VERSION=v23.0

# ── X, Threads, LinkedIn, TikTok (docs/CHANNELS.md has the setup for each) ──
# X: OAuth 2.0 app from developer.x.com. X_API_SECRET (the app's API secret) is
# only for direct-message webhooks; X bills API use per request from credits.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_API_SECRET=
# Threads: a Meta app with the Threads use case.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_WEBHOOK_VERIFY_TOKEN=
# LinkedIn needs the Community Management API approved first; set
# LINKEDIN_APPROVED=true only once LinkedIn has approved the app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_APPROVED=false
# LINKEDIN_SCOPES=r_organization_social w_organization_social
# LINKEDIN_API_VERSION=202601
# TikTok needs TikTok's approval first; set TIKTOK_APPROVED=true once granted.
TIKTOK_CLIENT_SECRET=
TIKTOK_APPROVED=false

# Email channel (Settings → Channels → Email) — see CLAUDE.md "Channels"
# Provider behind src/lib/channels/email/providers (only "postmark" so far).
EMAIL_PROVIDER=postmark
# Postmark Server API token: sends every email.
POSTMARK_SERVER_TOKEN=
# Postmark Account API token: lets workspaces authenticate their own sending domain (DKIM). Optional.
POSTMARK_ACCOUNT_TOKEN=
# Optional, default "outbound"
POSTMARK_MESSAGE_STREAM=outbound
# Domain whose MX records point at Postmark's inbound servers; each workspace gets <slug>@this-domain.
EMAIL_INBOUND_DOMAIN=
# Domain the platform sends from before a workspace verifies its own (must be verified in Postmark). Defaults to EMAIL_INBOUND_DOMAIN.
EMAIL_FROM_DOMAIN=
# "username:password" you put in the Postmark inbound webhook URL (https://username:password@your-app/api/channels/email/webhook).
EMAIL_WEBHOOK_AUTH=
# Signs the ticket token in reply-to addresses. Defaults to CHANNEL_ENCRYPTION_KEY.
EMAIL_TOKEN_SECRET=
# Bearer token the old LangGraph bridge must send to /api/agent/webhook (notes and escalations only).
AGENT_WEBHOOK_SECRET=


# Optional: TypeSafe (Jev) key, used when none is saved in Super admin -> Platform AI.
TYPESAFE_API_KEY=

# Optional: reading screenshots visitors send (src/lib/ai/vision.ts). A Gemini
# key, used for nothing else: replies and every other decision stay on the
# platform model (DeepSeek). Empty: images are not read.
VISION_API_KEY=
# Optional: another Gemini model than the default.
VISION_MODEL=


# ── AI -> Human Agent Handoff Notifications ─────────────────────────────────
# Web Push VAPID keys: generate with "npx web-push generate-vapid-keys"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@orbatai.com

# Telegram alerts: optional Telegram bot token for instant agent alerts
TELEGRAM_BOT_TOKEN=
