# Application Configuration
PORT=4000
NODE_ENV=development
# Comma-separated frontend URLs allowed by CORS (e.g. https://your-frontend.vercel.app,https://*.vercel.app)
CORS_ORIGIN=http://localhost:3000
# Optional primary frontend URL (also auto-added to CORS + default Google OAuth callback)
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Neon.tech or Local Postgres with pgvector — MUST match Frontend DATABASE_URL)
DATABASE_URL=postgresql://user:password@your-postgres-host:5432/neondb?sslmode=require
DATABASE_SSL=true

# JWT Authentication (Minimum 32 random chars required in production — MUST match Frontend JWT_SECRET)
JWT_SECRET=replace-with-strong-random-32-plus-char-jwt-secret
JWT_EXPIRES_IN=7d
# Optional in production (falls back to JWT_SECRET if omitted so both Vercel projects stay aligned)
JWT_REFRESH_SECRET=replace-with-strong-random-32-plus-char-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Redis Configuration (Optional in dev/Vercel HTTP mode; required for persistent Socket.IO + BullMQ workers)
REDIS_URL=redis://localhost:6379

# Cloudflare R2 Storage (S3-Compatible)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=orbat-chat-uploads
CLOUDFLARE_R2_PUBLIC_URL=

