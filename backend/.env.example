# Application Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database (Neon.tech or Local Postgres with pgvector)
DATABASE_URL=postgresql://user:password@ep-weathered-shape-03167363.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=true

# JWT Authentication
JWT_SECRET=orbat_ai_jwt_secret_change_in_production_key_32chars!
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=orbat_ai_refresh_secret_change_in_production_key!
JWT_REFRESH_EXPIRES_IN=30d

# Redis Configuration (Optional in dev, required for BullMQ and multi-instance Socket.IO)
REDIS_URL=redis://localhost:6379

# Cloudflare R2 Storage (S3-Compatible)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=orbat-chat-uploads
CLOUDFLARE_R2_PUBLIC_URL=

