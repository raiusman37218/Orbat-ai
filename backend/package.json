{
  "name": "orbat-backend",
  "version": "1.0.0",
  "description": "Orbat AI Enterprise Backend (NestJS)",
  "author": "Orbat AI Engineering",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "migrate": "ts-node scripts/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
